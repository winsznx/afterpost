# Afterpost environment variables — reference file, no real secrets.
# Copy to a root-level `.env` (`cp infra/env.example .env`) for local dev;
# Prisma, the API, and the worker all read from the root `.env`.
# Every key here is a config name the code actually reads today, or a name
# the PRD specifies for a sponsor integration not yet wired up. A value
# appearing here is an intended config key, not proof the endpoint exists.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:3001
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# PostgreSQL (Prisma) — local Docker Compose default (infra/docker-compose.yml).
# Port 5433, not 5432: a dev machine running multiple projects' Postgres
# containers collides on 5432 constantly, so this repo maps off the default.
#
# Two different roles, on purpose (Row-Level Security relies on this split —
# see prisma/migrations/*_row_level_security): DATABASE_URL is the app's
# runtime connection, as the restricted `afterpost_app` role RLS actually
# applies to. DIRECT_DATABASE_URL is the superuser role, used only by
# `prisma migrate` to run schema DDL. Never point the app's runtime
# connection at the superuser role — Postgres superusers bypass RLS
# unconditionally, silently making every policy a no-op.
#
# After running migrations for the first time, generate afterpost_app's
# password with: ./infra/scripts/set-app-role-password.sh
# That script prints the exact DATABASE_URL line to paste in below.
# ---------------------------------------------------------------------------
DIRECT_DATABASE_URL=postgresql://afterpost:afterpost@localhost:5433/afterpost
DATABASE_URL=postgresql://afterpost_app:REPLACE_ME@localhost:5433/afterpost

# ---------------------------------------------------------------------------
# Redis (BullMQ queues) — local Docker Compose default. Port 6380, same
# off-default reasoning as Postgres above.
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6380

# ---------------------------------------------------------------------------
# Auth.js — session signing + OAuth/email provider
# AUTH_SECRET: generate with `openssl rand -base64 32`
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET: Google Cloud Console →
#   APIs & Services → Credentials → OAuth 2.0 Client ID (Web application).
#   Add http://localhost:3000/api/auth/callback/google as an authorized
#   redirect URI for local dev.
# ---------------------------------------------------------------------------
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Transactional email (magic links, invites, notifications)
# Use whichever provider you actually have — Resend, Postmark, SES, etc.
# EMAIL_PROVIDER selects which client the API constructs.
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=resend
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=noreply@afterpost.example

# ---------------------------------------------------------------------------
# Object storage (raw evidence uploads, report exports)
# Any S3-compatible provider works: Cloudflare R2, AWS S3, MinIO (self-hosted).
# OBJECT_STORAGE_ENDPOINT: leave blank for real AWS S3; set for R2/MinIO.
# ---------------------------------------------------------------------------
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=afterpost-evidence
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Robinhood Chain — public RPC, no credentials required.
# Verified live 2026-10-27: eth_chainId == 4663. See docs/INTEGRATIONS.md.
# ROBINHOOD_RPC_FALLBACK_URL: optional second provider (e.g. a paid RPC
# plan) to fail over to if the public endpoint rate-limits.
# ---------------------------------------------------------------------------
CHAIN_ID=4663
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_RPC_FALLBACK_URL=
CHAIN_SAFE_BLOCK_LAG=30

# ---------------------------------------------------------------------------
# Zetaris — federated query sponsor integration (PRD §11.1). BLOCKED until
# you provide real tenant credentials; see docs/INTEGRATIONS.md.
# ZETARIS_API_BASE_URL: your tenant's actual deployed REST base URL —
#   the public kbase docs describe the DBQuery/OpenSqlQuery,
#   PageSqlQuery, CloseSqlQuery routes conceptually, not your tenant's
#   exact path. Get this + the key from your Zetaris tenant admin console.
# ZETARIS_API_KEY: bearer/login token from that console.
# ZETARIS_ORG_ID: your tenant/org identifier, if the deployment uses one.
# ---------------------------------------------------------------------------
ZETARIS_API_BASE_URL=
ZETARIS_API_KEY=
ZETARIS_ORG_ID=
ZETARIS_QUERY_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# NVIDIA NIM / Nemotron — multimodal evidence extraction (PRD §11.3).
# BLOCKED until you provide a real key; see docs/INTEGRATIONS.md.
# NVIDIA_NIM_BASE_URL: https://integrate.api.nvidia.com/v1 for the hosted
#   NVIDIA API catalog, or your own self-hosted NIM endpoint.
# NVIDIA_API_KEY: from https://build.nvidia.com (API catalog) → your
#   account → API keys, after accepting the Nemotron model's terms.
# NEMOTRON_MODEL_ID: confirm the exact deployed model slug in the NVIDIA
#   API catalog console before relying on this value — it is the PRD's
#   documented target, not a guarantee of availability.
# ---------------------------------------------------------------------------
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
NEMOTRON_MODEL_ID=nvidia/nemotron-3.5-super-vl-120b-a12b

# ---------------------------------------------------------------------------
# Meterless (H-MEM / World Model) — self-hosted implementation, not a
# hosted API (PRD §11.2). Pin the exact upstream commit you build against.
# Get the commit hash from https://github.com/Meterless/Meterless (and
# the H-MEM / World-Model sibling repos) after you've chosen a release.
# ---------------------------------------------------------------------------
METERLESS_UPSTREAM_REF=

# ---------------------------------------------------------------------------
# Report export signing (presigned/short-lived export URLs)
# REPORT_SIGNING_SECRET: generate with `openssl rand -base64 32`
# ---------------------------------------------------------------------------
REPORT_SIGNING_SECRET=

# ---------------------------------------------------------------------------
# Error reporting / tracing (optional but recommended before production)
# SENTRY_DSN: from your Sentry project settings → Client Keys (DSN).
# ---------------------------------------------------------------------------
SENTRY_DSN=

# ---------------------------------------------------------------------------
# Deployment — Vercel (web) + VPS (API/worker/Postgres/Redis via Docker
# Compose). These are not read by application code; they're for your CI/CD
# and deploy scripts.
# VERCEL_TOKEN: https://vercel.com/account/tokens
# VERCEL_ORG_ID / VERCEL_PROJECT_ID: `vercel link` writes these into
#   .vercel/project.json after you link the project interactively.
# VPS_SSH_HOST / VPS_SSH_USER: your Coden VPS connection details.
# ---------------------------------------------------------------------------
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
VPS_SSH_HOST=
VPS_SSH_USER=

# ---------------------------------------------------------------------------
# GitHub (for CI/CD and repo automation, not application runtime)
# GITHUB_TOKEN: a fine-grained PAT with repo scope, or use `gh auth login`
#   locally instead of storing a token here.
# ---------------------------------------------------------------------------
GITHUB_TOKEN=
